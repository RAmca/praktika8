#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    int n;
    printf("Введите n: ");
    scanf("%d", &n);

    // 2^0 = 1
    long long power = 1;
    for (int i = 0; i <= n; i++) {
        printf("2^%d = %lld\n", i, power);
        power *= 2;
    }

    return 0;
}
