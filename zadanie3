#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    int N;
    printf("Введите N: ");
    scanf("%d", &N);

    double fact = 1.0;

    for (int i = 1; i <= N; i++) {
        fact *= i;
    }

    printf("%d! = %.0f\n", N, fact);
    return 0;
}
